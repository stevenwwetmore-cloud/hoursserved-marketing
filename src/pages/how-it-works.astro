---
import '../styles/global.css';
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
import Card from '../components/Card.astro';
import MarketingNav from '../components/MarketingNav';
import TopBenefitsHero from '../components/TopBenefitsHero';
import MarketingFooter from '../components/MarketingFooter';
---

<Layout
  title="How It Works | HoursServed"
  description="See how HoursServed connects one-click attendance, Google Calendar meeting and event drafts, and downloadable Lion Portal-ready reports. Automated uploads require written LCI approval."
>
  <div style={{backgroundColor: '#F1EFE8'}} class="text-gray-900">
    <MarketingNav client:load />

    <main id="main-content" tabindex="-1">

      {/* ── HERO ── */}
      <Section>
        <Card variant="white">
          <p class="text-base font-medium tracking-[.08em] uppercase text-brand-navy mb-4">
            How HoursServed works
          </p>
          <h1 class="text-[36px] leading-[1.15] tracking-tight mb-4 text-gray-900">
            <span class="font-serif italic text-brand-navy">For officers</span>
            <br />
            <span>who take their role </span>
            <span class="font-serif italic text-brand-teal-dark">seriously.</span>
          </h1>
          <p class="text-base text-brand-ink leading-relaxed max-w-xl">
            Club secretaries, presidents, and district governors have real work to do — coaching
            clubs, closing months, meeting Lions International reporting standards. HoursServed
            makes sure the administration keeps pace with the leadership.
          </p>
        </Card>
      </Section>

      <TopBenefitsHero />

      {/* ── DISTRICT VISIBILITY ── */}
      <Section>
        <Card variant="navy">
          <p class="text-base font-medium tracking-[.08em] uppercase text-white mb-3">
            District visibility
          </p>
          <h2 class="text-[28px] leading-snug tracking-tight mb-3">
            <span class="font-serif italic text-white">The visibility</span>
            <span class="text-white"> to coach.<br />The records to report.</span>
          </h2>
          <p class="text-base text-white/80 leading-relaxed max-w-lg mb-8">
            District governors and secretaries get a live view across every club — reporting
            coverage, open corrections, event activity, and Lions Portal readiness — without
            touching data inside any club.
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div class="rounded-lg p-4 bg-white/5" style={{borderTop: '2px solid #0F6E56'}}>
              <p class="text-base font-medium mb-1.5 text-white">Coverage tracking</p>
              <p class="text-base font-medium text-white mb-1">Every club, one view</p>
              <p class="text-base text-white/80 leading-relaxed">See which clubs are complete, in progress, or overdue — before month-end arrives.</p>
            </div>

            <div class="rounded-lg p-4 bg-white/5" style={{borderTop: '2px solid #1E3A5F'}}>
              <p class="text-base font-medium mb-1.5 text-white">Corrections visibility</p>
              <p class="text-base font-medium text-white mb-1">Open issues, sorted by severity</p>
              <p class="text-base text-white/80 leading-relaxed">Know which clubs need a call — and what to talk about when you make it.</p>
            </div>

            <div class="rounded-lg p-4 bg-white/5" style={{borderTop: '2px solid #1E3A5F'}}>
              <p class="text-base font-medium mb-1.5 text-white">Export readiness</p>
              <p class="text-base font-medium text-white mb-1">No month-end surprises</p>
              <p class="text-base text-white/80 leading-relaxed">See which clubs are Lions Portal–ready and what's blocking the rest.</p>
            </div>

            <div class="rounded-lg p-4 bg-white/5" style={{borderTop: '2px solid #0F6E56'}}>
              <p class="text-base font-medium mb-1.5 text-white">Read-only access</p>
              <p class="text-base font-medium text-white mb-1">Oversight without interference</p>
              <p class="text-base text-white/80 leading-relaxed">District officers see everything they need. They can't edit data inside any club.</p>
            </div>
          </div>
        </Card>
      </Section>

      {/* ── DIVIDER ── */}
      <Section class="py-6">
        <div class="flex items-center gap-3">
          <div class="flex-1 h-px bg-gray-300" />
          <span class="text-base font-medium tracking-[.1em] uppercase text-gray-600">Club-level features</span>
          <div class="flex-1 h-px bg-gray-300" />
        </div>
      </Section>

      {/* ── MEETING RSVPS ── */}
      <Section>
        <Card variant="white">
          <p class="text-base font-medium tracking-[.08em] uppercase mb-2 text-brand-navy">Meeting RSVPs</p>
          <h2 class="text-xl font-medium leading-snug text-gray-900 mb-2.5">One email. Two buttons. Attendance handled.</h2>
          <p class="text-base leading-relaxed text-brand-ink max-w-xl mb-6">
            Create a meeting, send invitations in one click, and every member receives a personal email with a Yes or No button. No passwords, no app downloads. Responses update your attendance record in real time.
          </p>
          <div class="flex flex-col gap-3.5">
            <div class="flex gap-2.5 items-start">
              <div class="w-[22px] h-[22px] rounded-full text-white text-base font-medium flex items-center justify-center shrink-0 mt-0.5 bg-brand-navy">1</div>
              <p class="text-base leading-relaxed text-brand-ink"><strong class="text-gray-900 font-medium">Create the event</strong> — name, date, location, and an optional note to members.</p>
            </div>
            <div class="flex gap-2.5 items-start">
              <div class="w-[22px] h-[22px] rounded-full text-white text-base font-medium flex items-center justify-center shrink-0 mt-0.5 bg-brand-navy">2</div>
              <p class="text-base leading-relaxed text-brand-ink"><strong class="text-gray-900 font-medium">Send invitations</strong> with one click. Every active member gets a personalized email.</p>
            </div>
            <div class="flex gap-2.5 items-start">
              <div class="w-[22px] h-[22px] rounded-full text-white text-base font-medium flex items-center justify-center shrink-0 mt-0.5 bg-brand-navy">3</div>
              <p class="text-base leading-relaxed text-brand-ink"><strong class="text-gray-900 font-medium">Members tap Yes or No</strong> directly in the email. No account, no app required.</p>
            </div>
            <div class="flex gap-2.5 items-start">
              <div class="w-[22px] h-[22px] rounded-full text-white text-base font-medium flex items-center justify-center shrink-0 mt-0.5 bg-brand-navy">4</div>
              <p class="text-base leading-relaxed text-brand-ink"><strong class="text-gray-900 font-medium">Dashboard updates instantly</strong> — who's coming, who declined, who hasn't replied.</p>
            </div>
            <div class="flex gap-2 items-start bg-blue-50 rounded-lg px-3.5 py-2.5 mt-2">
              <div class="w-3 h-3 rounded-full bg-brand-navy shrink-0 mt-0.5" />
              <p class="text-base text-brand-navy leading-relaxed">Members never create a password or download anything. Every action happens inside the email they already received.</p>
            </div>
          </div>
          <div class="hidden md:flex md:justify-center md:mt-8">
            <div class="flex flex-col gap-3 max-w-2xl w-full">
              <img
                src="/images/attendance-requested-alt.png"
                alt="Attendance request email with Yes / No buttons"
                class="rounded-xl border border-gray-100 shadow-sm w-full"
              />
              <img
                src="/images/attendance-confirmed-alt.png"
                alt="Attendance confirmed screen"
                class="rounded-xl border border-gray-100 shadow-sm w-full"
              />
            </div>
          </div>
        </Card>
      </Section>

      {/* ── SERVICE HOURS ── */}
      <Section>
        <Card variant="white">
          <p class="text-base font-medium tracking-[.08em] uppercase mb-2 text-brand-navy">Service hours</p>
          <h2 class="text-xl font-medium leading-snug text-gray-900 mb-2.5">Collecting hours without chasing people.</h2>
          <p class="text-base leading-relaxed text-brand-ink max-w-xl mb-6">
            Members submit hours through a simple form. You review and approve. HoursServed compiles everything — no spreadsheets, no data entry at month-end.
          </p>
          <div class="flex flex-col gap-3.5">
            <div class="flex gap-2.5 items-start">
              <div class="w-[22px] h-[22px] rounded-full text-white text-base font-medium flex items-center justify-center shrink-0 mt-0.5 bg-brand-navy">1</div>
              <p class="text-base leading-relaxed text-brand-ink"><strong class="text-gray-900 font-medium">Members submit hours</strong> via a shared link. No login required.</p>
            </div>
            <div class="flex gap-2.5 items-start">
              <div class="w-[22px] h-[22px] rounded-full text-white text-base font-medium flex items-center justify-center shrink-0 mt-0.5 bg-brand-navy">2</div>
              <p class="text-base leading-relaxed text-brand-ink"><strong class="text-gray-900 font-medium">Review submissions</strong> in the Work Queue. Approve or flag for correction.</p>
            </div>
            <div class="flex gap-2.5 items-start">
              <div class="w-[22px] h-[22px] rounded-full text-white text-base font-medium flex items-center justify-center shrink-0 mt-0.5 bg-brand-navy">3</div>
              <p class="text-base leading-relaxed text-brand-ink"><strong class="text-gray-900 font-medium">Approved hours lock by month</strong> — no accidental overwrites when the secretary changes.</p>
            </div>
            <div class="flex gap-2.5 items-start">
              <div class="w-[22px] h-[22px] rounded-full text-white text-base font-medium flex items-center justify-center shrink-0 mt-0.5 bg-brand-navy">4</div>
              <p class="text-base leading-relaxed text-brand-ink"><strong class="text-gray-900 font-medium">Reports compile automatically</strong> from approved data, ready for your district or board.</p>
            </div>
          </div>
          <div class="hidden md:flex md:justify-center md:mt-8">
            <div class="bg-gray-50 rounded-xl p-3 border border-gray-100 w-full max-w-2xl mx-auto">
              <div class="bg-white rounded-lg border border-gray-100 overflow-hidden">
                <div class="bg-gray-50 px-3 py-2 border-b border-gray-100 text-base font-medium text-gray-900">Report service hours</div>
                <div class="p-3">
                  <div class="block text-base font-medium text-gray-600 uppercase tracking-wide mb-0.5">Project / activity</div>
                  <div class="bg-gray-50 border border-gray-100 rounded text-base text-gray-900 px-2 py-1.5 mb-2">Food bank – sorting shift</div>
                  <div class="grid grid-cols-2 gap-1.5 mb-2">
                    <div>
                      <div class="block text-base font-medium text-gray-600 uppercase tracking-wide mb-0.5">Date</div>
                      <div class="bg-gray-50 border border-gray-100 rounded text-base text-gray-900 px-2 py-1.5">May 8, 2025</div>
                    </div>
                    <div>
                      <div class="block text-base font-medium text-gray-600 uppercase tracking-wide mb-0.5">Hours</div>
                      <div class="bg-gray-50 border border-gray-100 rounded text-base text-gray-900 px-2 py-1.5">3.5 hrs</div>
                    </div>
                  </div>
                  <div class="block text-base font-medium text-gray-600 uppercase tracking-wide mb-0.5">Category</div>
                  <div class="bg-gray-50 border border-gray-100 rounded text-base text-gray-900 px-2 py-1.5 mb-2.5">Community service</div>
                  <button class="w-full bg-brand-navy text-white rounded text-base font-medium py-1.5">Submit hours</button>
                </div>
              </div>

              <div class="bg-white rounded-lg border border-gray-100 overflow-hidden mt-2.5">
                <div class="bg-gray-50 px-3 py-1.5 flex justify-between items-center border-b border-gray-100">
                  <span class="text-base font-medium text-gray-900">Pending approval</span>
                  <span class="text-base bg-brand-navy text-white px-2 py-0.5 rounded-full font-medium">3 new</span>
                </div>
                <div class="px-3 py-2">
                  <div class="flex justify-between mb-1.5">
                    <span class="text-base text-gray-900">Margaret K. — Food bank</span>
                    <span class="text-base font-medium text-gray-900">3.5 hrs</span>
                  </div>
                  <div class="flex gap-1.5">
                    <button class="bg-brand-navy text-white rounded text-base px-2 py-0.5">Approve</button>
                    <button class="bg-gray-50 border border-gray-200 text-gray-600 rounded text-base px-2 py-0.5">Flag</button>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </Card>
      </Section>

      {/* ── MONTHLY REPORTS ── */}
      <Section>
        <Card variant="white">
          <p class="text-base font-medium tracking-[.08em] uppercase mb-2 text-brand-navy">Monthly reports</p>
          <h2 class="text-xl font-medium leading-snug text-gray-900 mb-2.5">Reports that generate themselves, then lock.</h2>
          <p class="text-base leading-relaxed text-brand-ink max-w-xl mb-6">
            At month-end HoursServed assembles the report from approved data — attendance, hours, member activity. Officers review by email, approve, and the month locks permanently. Records stay intact regardless of who takes over next year.
          </p>
          <div class="flex flex-col gap-3.5">
            <div class="flex gap-2.5 items-start">
              <div class="w-[22px] h-[22px] rounded-full text-white text-base font-medium flex items-center justify-center shrink-0 mt-0.5 bg-brand-navy">1</div>
              <p class="text-base leading-relaxed text-brand-ink"><strong class="text-gray-900 font-medium">Auto-generation runs</strong> on the last day of the month from all approved submissions.</p>
            </div>
            <div class="flex gap-2.5 items-start">
              <div class="w-[22px] h-[22px] rounded-full text-white text-base font-medium flex items-center justify-center shrink-0 mt-0.5 bg-brand-navy">2</div>
              <p class="text-base leading-relaxed text-brand-ink"><strong class="text-gray-900 font-medium">Officers receive the report</strong> by email and approve or request corrections — no login needed.</p>
            </div>
            <div class="flex gap-2.5 items-start">
              <div class="w-[22px] h-[22px] rounded-full text-white text-base font-medium flex items-center justify-center shrink-0 mt-0.5 bg-brand-navy">3</div>
              <p class="text-base leading-relaxed text-brand-ink"><strong class="text-gray-900 font-medium">Month locks on approval.</strong> Data is permanent and auditable regardless of future officer changes.</p>
            </div>
            <div class="flex gap-2.5 items-start">
              <div class="w-[22px] h-[22px] rounded-full text-white text-base font-medium flex items-center justify-center shrink-0 mt-0.5 bg-brand-navy">4</div>
              <p class="text-base leading-relaxed text-brand-ink"><strong class="text-gray-900 font-medium">Export in one click</strong> — formatted for Lions Portal or your district system.</p>
            </div>
          </div>
          <div class="hidden md:flex md:justify-center md:mt-8">
            <div class="bg-gray-50 rounded-xl p-3 border border-gray-100 w-full max-w-2xl mx-auto">
              <div class="bg-white rounded-lg border border-gray-100 overflow-hidden">
                <div class="bg-brand-navy px-3 py-2">
                  <p class="text-base mb-0.5" style={{color: '#E8EDF3'}}>Westdale Lions Club</p>
                  <p class="text-base font-medium text-white">April 2025 — Monthly Report</p>
                </div>
                <div class="grid grid-cols-3 border-b border-gray-100">
                  <div class="py-2 text-center border-r border-gray-100">
                    <p class="text-xl font-bold text-gray-900">24</p>
                    <p class="text-base text-gray-600 uppercase tracking-wide">Members</p>
                  </div>
                  <div class="py-2 text-center border-r border-gray-100">
                    <p class="text-xl font-bold text-gray-900">142</p>
                    <p class="text-base text-gray-600 uppercase tracking-wide">Hours</p>
                  </div>
                  <div class="py-2 text-center">
                    <p class="text-xl font-bold text-gray-900">87%</p>
                    <p class="text-base text-gray-600 uppercase tracking-wide">Attendance</p>
                  </div>
                </div>
                <div class="flex justify-between items-center px-3 py-2 border-b border-gray-100 text-base">
                  <span class="text-gray-600">Margaret Kowalski</span>
                  <span class="font-medium text-gray-900">12.5 hrs</span>
                </div>
                <div class="flex justify-between items-center px-3 py-2 border-b border-gray-100 text-base">
                  <span class="text-gray-600">Robert Chen</span>
                  <span class="font-medium text-gray-900">8.0 hrs</span>
                </div>
                <div class="flex justify-between items-center px-3 py-2 border-b border-gray-100 text-base">
                  <span class="text-gray-600">Patricia Wallace</span>
                  <span class="font-medium text-gray-900">6.5 hrs</span>
                </div>
                <div class="flex justify-between items-center px-3 py-2 border-b border-gray-100 text-base text-gray-600">
                  <span>+ 21 more members</span>
                  <span></span>
                </div>
                <div class="flex gap-1.5 px-3 py-2 bg-gray-50">
                  <button class="flex-1 bg-brand-navy text-white rounded text-base font-medium py-1.5">Approve &amp; lock report</button>
                  <button class="flex-1 bg-white border border-gray-200 text-gray-600 rounded text-base py-1.5">Request corrections</button>
                </div>
              </div>
            </div>
          </div>
        </Card>
      </Section>

      {/* ── VOLUNTEER SHIFTS ── */}
      <Section>
        <Card variant="white">
          <p class="text-base font-medium tracking-[.08em] uppercase mb-2 text-brand-navy">Volunteer shifts</p>
          <h2 class="text-xl font-medium leading-snug text-gray-900 mb-2.5">Shift sign-ups without the group-chat chaos.</h2>
          <p class="text-base leading-relaxed text-brand-ink max-w-xl mb-6">
            Create time slots for your events, share a link, and members claim shifts directly — no spreadsheet, no reply-all. Hours from completed shifts flow into the service record automatically.
          </p>
          <div class="flex flex-col gap-3.5">
            <div class="flex gap-2.5 items-start">
              <div class="w-[22px] h-[22px] rounded-full text-white text-base font-medium flex items-center justify-center shrink-0 mt-0.5 bg-brand-navy">1</div>
              <p class="text-base leading-relaxed text-brand-ink"><strong class="text-gray-900 font-medium">Define shifts</strong> — time, role, and capacity for each slot.</p>
            </div>
            <div class="flex gap-2.5 items-start">
              <div class="w-[22px] h-[22px] rounded-full text-white text-base font-medium flex items-center justify-center shrink-0 mt-0.5 bg-brand-navy">2</div>
              <p class="text-base leading-relaxed text-brand-ink"><strong class="text-gray-900 font-medium">Share the sign-up link</strong> by email or newsletter. No login required to claim a slot.</p>
            </div>
            <div class="flex gap-2.5 items-start">
              <div class="w-[22px] h-[22px] rounded-full text-white text-base font-medium flex items-center justify-center shrink-0 mt-0.5 bg-brand-navy">3</div>
              <p class="text-base leading-relaxed text-brand-ink"><strong class="text-gray-900 font-medium">Members claim a shift</strong> and receive instant email confirmation.</p>
            </div>
            <div class="flex gap-2.5 items-start">
              <div class="w-[22px] h-[22px] rounded-full text-white text-base font-medium flex items-center justify-center shrink-0 mt-0.5 bg-brand-navy">4</div>
              <p class="text-base leading-relaxed text-brand-ink"><strong class="text-gray-900 font-medium">Hours post automatically</strong> after the shift — nothing to enter manually.</p>
            </div>
          </div>
          <div class="hidden md:flex md:justify-center md:mt-8">
            <div class="bg-gray-50 rounded-xl p-3 border border-gray-100 w-full max-w-2xl mx-auto">
              <div class="bg-white rounded-lg border border-gray-100 overflow-hidden">
                <div class="bg-gray-50 px-3 py-2 border-b border-gray-100">
                  <p class="text-base font-medium text-gray-900">Harvest Dinner — Nov 2</p>
                  <p class="text-base text-gray-600">Sign up for a volunteer shift</p>
                </div>
                <div class="flex justify-between items-center px-3 py-2 border-b border-gray-100">
                  <div>
                    <p class="text-base font-medium text-gray-900">3:00 – 5:00 PM</p>
                    <p class="text-base text-gray-600">Setup crew</p>
                  </div>
                  <div class="flex items-center gap-1.5">
                    <span class="text-base text-gray-600">1 left</span>
                    <button class="bg-brand-navy text-white rounded text-base px-1.5 py-0.5">Claim</button>
                  </div>
                </div>
                <div class="flex justify-between items-center px-3 py-2 border-b border-gray-100">
                  <div>
                    <p class="text-base font-medium text-gray-900">5:30 – 8:00 PM</p>
                    <p class="text-base text-gray-600">Serving tables</p>
                  </div>
                  <div class="flex items-center gap-1.5">
                    <span class="text-base text-gray-600">3 spots</span>
                    <button class="bg-brand-navy text-white rounded text-base px-1.5 py-0.5">Claim</button>
                  </div>
                </div>
                <div class="flex justify-between items-center px-3 py-2 border-b border-gray-100 bg-gray-50">
                  <div>
                    <p class="text-base font-medium text-gray-900">8:00 – 9:30 PM</p>
                    <p class="text-base text-gray-600">Cleanup</p>
                  </div>
                  <span class="text-base text-gray-600">Full</span>
                </div>
                <p class="px-3 py-2 text-base text-gray-600">Hours recorded automatically after your shift.</p>
              </div>
            </div>
          </div>
        </Card>
      </Section>

      {/* ── OFFICER TRANSITION ── */}
      <Section>
        <Card variant="white">
          <p class="text-base font-medium tracking-[.08em] uppercase mb-2 text-brand-navy">Officer transition</p>
          <h2 class="text-xl font-medium leading-snug text-gray-900 mb-2.5">New secretary. Zero lost history.</h2>
          <p class="text-base leading-relaxed text-brand-ink max-w-xl mb-6">
            When your executive turns over, no data migrates, no spreadsheets get emailed, and nothing lives on someone's laptop. The incoming officer logs in and the full record is already there.
          </p>
          <div class="flex flex-col gap-3.5">
            <div class="flex gap-2.5 items-start">
              <div class="w-[22px] h-[22px] rounded-full text-white text-base font-medium flex items-center justify-center shrink-0 mt-0.5 bg-brand-navy">1</div>
              <p class="text-base leading-relaxed text-brand-ink"><strong class="text-gray-900 font-medium">Invite the incoming officer</strong> by email — access granted instantly, no IT required.</p>
            </div>
            <div class="flex gap-2.5 items-start">
              <div class="w-[22px] h-[22px] rounded-full text-white text-base font-medium flex items-center justify-center shrink-0 mt-0.5 bg-brand-navy">2</div>
              <p class="text-base leading-relaxed text-brand-ink"><strong class="text-gray-900 font-medium">Full history is immediately visible</strong> — every locked month, approved report, and member record.</p>
            </div>
            <div class="flex gap-2.5 items-start">
              <div class="w-[22px] h-[22px] rounded-full text-white text-base font-medium flex items-center justify-center shrink-0 mt-0.5 bg-brand-navy">3</div>
              <p class="text-base leading-relaxed text-brand-ink"><strong class="text-gray-900 font-medium">Remove the outgoing officer</strong> and their access expires. Nothing leaves with them.</p>
            </div>
            <div class="flex gap-2.5 items-start">
              <div class="w-[22px] h-[22px] rounded-full text-white text-base font-medium flex items-center justify-center shrink-0 mt-0.5 bg-brand-navy">4</div>
              <p class="text-base leading-relaxed text-brand-ink"><strong class="text-gray-900 font-medium">Role-based access</strong> — secretary, president, and district officers each see what's appropriate to their role.</p>
            </div>
            <div class="flex gap-2 items-start bg-blue-50 rounded-lg px-3.5 py-2.5 mt-2">
              <div class="w-3 h-3 rounded-full bg-brand-navy shrink-0 mt-0.5" />
              <p class="text-base text-brand-navy leading-relaxed">Officer transitions typically take 4–6 hours. With HoursServed, about 10 minutes.</p>
            </div>
          </div>
          <div class="hidden md:flex md:justify-center md:mt-8">
            <div class="bg-gray-50 rounded-xl p-3 border border-gray-100 w-full max-w-2xl mx-auto">
              <div class="bg-white rounded-lg border border-gray-100 overflow-hidden">
                <div class="bg-brand-navy px-3 py-2 flex justify-between items-center">
