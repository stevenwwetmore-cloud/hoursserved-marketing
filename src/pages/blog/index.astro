---
import Layout from '../../layouts/Layout.astro';
import MarketingNav from '../../components/MarketingNav';
import MarketingFooter from '../../components/MarketingFooter';
import { Shield, ArrowRight, Calendar, Tag } from 'lucide-react';

const APP_ID = '69ac4eaa5a3031dffe252cf9';
const BASE_URL = 'https://base44.app/api';

async function fetchPosts() {
  try {
    const url = `${BASE_URL}/apps/${APP_ID}/entities/BlogPost?q=${encodeURIComponent(JSON.stringify({ status: 'published' }))}&sort=-published_at`;
    const response = await fetch(url, {
      headers: { 'X-App-Id': APP_ID },
    });
    if (!response.ok) return [];
    const data = await response.json();
    return Array.isArray(data) ? data : [];
  } catch (error) {
    console.error('Failed to fetch blog posts:', error);
    return [];
  }
}

const posts = await fetchPosts();

function formatDate(dateStr: string) {
  const date = new Date(dateStr);
  return date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}
---

<Layout
  title="Blog | HoursServed"
  description="Tips, updates, and insights for service club administrators on attendance tracking, volunteer management, and reporting."
>
  <div class="min-h-screen bg-white">
    <nav class="sticky top-0 z-40 bg-white/95 backdrop-blur border-b border-gray-100">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2">
          <div class="w-7 h-7 bg-blue-600 rounded-lg flex items-center justify-center">
            <Shield className="w-4 h-4 text-white" />
          </div>
          <span class="font-bold text-gray-900">Hours Served</span>
        </a>
        <a href="/" class="text-sm text-gray-500 hover:text-gray-900 transition-colors">← Back to Home</a>
      </div>
    </nav>

    <div class="max-w-4xl mx-auto px-4 sm:px-6 py-16">
      <div class="mb-12">
        <h1 class="text-4xl font-bold text-gray-900 mb-3">Blog</h1>
        <p class="text-gray-500 text-lg">Tips, updates, and insights for service club administrators.</p>
      </div>

      {posts.length === 0 && (
        <div class="text-center py-24 border border-dashed border-gray-200 rounded-2xl">
          <p class="text-gray-400 text-lg font-medium">Articles coming soon</p>
          <p class="text-gray-400 text-sm mt-2">Check back shortly for tips and updates.</p>
        </div>
      )}

      {posts.length > 0 && (
        <div class="space-y-8">
          {posts.map((post: any) => (
            <a
              href={`/blog/${post.slug || post.id}/`}
              class="group block bg-white border border-gray-200 rounded-2xl overflow-hidden hover:border-blue-300 hover:shadow-md transition-all"
            >
              {post.cover_image_url && (
                <img
                  src={post.cover_image_url}
                  alt={post.title}
                  class="w-full h-52 object-cover"
                />
              )}
              <div class="p-6">
                <div class="flex items-center gap-3 text-xs text-gray-400 mb-3">
                  {post.published_at && (
                    <span class="flex items-center gap-1">
                      <Calendar className="w-3 h-3" />
                      {formatDate(post.published_at)}
                    </span>
                  )}
                  {post.tags && (
                    <span class="flex items-center gap-1">
                      <Tag className="w-3 h-3" />
                      {post.tags.split(',')[0].trim()}
                    </span>
                  )}
                </div>
                <h2 class="text-xl font-bold text-gray-900 mb-2 group-hover:text-blue-600 transition-colors">{post.title}</h2>
                {post.excerpt && <p class="text-gray-500 text-sm leading-relaxed mb-4">{post.excerpt}</p>}
                <div class="flex items-center gap-1 text-blue-600 text-sm font-medium">
                  Read article <ArrowRight className="w-4 h-4" />
                </div>
              </div>
            </a>
          ))}
        </div>
      )}
    </div>
    <MarketingFooter />
  </div>
</Layout>
