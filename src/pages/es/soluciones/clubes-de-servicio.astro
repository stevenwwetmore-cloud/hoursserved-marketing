---
import Layout from '../../../layouts/Layout.astro';
import LatamNav from '../../../components/LatamNav';
import LatamFooter from '../../../components/LatamFooter';
---
<Layout locale="es-419" title="HoursServed para Clubes de Lions" description="Reduce el trabajo administrativo de los oficiales con asistencia sin contraseña, eventos y reportes descargables." canonical="https://www.hoursserved.com/es/soluciones/clubes-de-servicio/">
  <div class="min-h-screen bg-canvas font-sans"><LatamNav client:load /><main id="main-content" tabindex="-1"><section class="px-4 py-16 sm:px-6"><div class="max-w-4xl mx-auto bg-white border border-card-border rounded-3xl p-7 sm:p-12 text-center"><p class="text-xs font-bold uppercase tracking-widest text-brand-teal-dark mb-3">Para Clubes de Lions</p><h1 class="text-4xl sm:text-5xl font-black text-brand-navy mb-5">Administra el club sin perseguir respuestas</h1><p class="text-lg text-gray-700 leading-relaxed mb-8">HoursServed conecta reuniones, asistencia, servicio, voluntarios y revisión mensual para que los oficiales trabajen con un registro claro.</p><a href="/es/contacto/" class="inline-block bg-brand-teal-dark text-white font-bold px-8 py-4 rounded-xl">Solicitar una demo</a></div></section><section class="px-4 pb-16 sm:px-6"><div class="max-w-5xl mx-auto grid md:grid-cols-3 gap-5">{[
      ['Respuesta con un clic', 'Los miembros confirman asistencia desde el correo electrónico sin contraseña.'],
      ['Registro conectado', 'La asistencia, las horas y los detalles del evento permanecen vinculados.'],
      ['Reporte revisado', 'Un oficial aprueba el reporte antes de descargar el CSV o PDF para el Portal de Lions.'],
    ].map(([title, body]) => (<article class="bg-white border border-card-border rounded-2xl p-6"><h2 class="text-xl font-bold text-brand-navy mb-3">{title}</h2><p class="text-base text-gray-700 leading-relaxed">{body}</p></article>))}</div></section></main><LatamFooter /></div>
</Layout>
