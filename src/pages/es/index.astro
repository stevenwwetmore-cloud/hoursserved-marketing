---
import Layout from '../../layouts/Layout.astro';
import LatamNav from '../../components/LatamNav';
import LatamFooter from '../../components/LatamFooter';
import TopBenefitsHero from '../../components/TopBenefitsHero';
---
<Layout locale="es-419" title="HoursServed para Clubes de Lions en América Latina" description="Controla la asistencia, los eventos y las horas de servicio con menos trabajo administrativo para los oficiales." canonical="https://www.hoursserved.com/es/">
  <div class="min-h-screen bg-canvas font-sans"><LatamNav client:load /><main id="main-content" tabindex="-1">
<section class="px-4 py-16 sm:px-6"><div class="max-w-4xl mx-auto bg-brand-navy rounded-3xl px-6 py-14 sm:px-12 text-center text-white"><p class="text-xs font-bold uppercase tracking-widest text-[#6DE2D6] mb-4">Creado para Clubes de Lions en América Latina</p><h1 class="text-4xl sm:text-6xl font-black leading-tight mb-6">Menos administración. Más tiempo para servir.</h1><p class="text-lg leading-relaxed max-w-2xl mx-auto mb-8">HoursServed ayuda a los oficiales a organizar asistencia, reuniones, eventos, horas de servicio y reportes mensuales en un solo flujo de trabajo.</p><div class="flex flex-col sm:flex-row gap-3 justify-center"><a href="/es/contacto/" class="bg-white text-brand-navy font-bold px-8 py-4 rounded-xl">Solicitar una demo</a><a href="/es/como-funciona/" class="border border-white text-white font-bold px-8 py-4 rounded-xl">Ver cómo funciona</a></div></div></section>
<TopBenefitsHero locale="es-419" />
    <section class="px-4 pb-16 sm:px-6"><div class="max-w-5xl mx-auto grid md:grid-cols-3 gap-5">{[
      ['Asistencia sin contraseña', 'Los miembros responden Sí o No desde un enlace seguro de correo electrónico, sin crear una cuenta.'],
      ['Eventos listos para revisar', 'Importa eventos de Google Calendar como borradores y confirma la duración y el tiempo de traslado antes de activarlos.'],
      ['Reportes preparados', 'Revisa los reportes con un oficial y descarga archivos CSV o PDF para el proceso actual del Lion Portal.'],
    ].map(([title, body]) => (<article class="bg-white border border-card-border rounded-2xl p-6"><h2 class="text-xl font-bold text-brand-navy mb-3">{title}</h2><p class="text-base text-gray-700 leading-relaxed">{body}</p></article>))}</div></section>
  </main><LatamFooter /></div>
</Layout>
