---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  locale?: 'en' | 'es-419';
}

const {
  title = 'HoursServed',
  description = 'Attendance and volunteer hour tracking for service-led organizations.',
  canonical,
  locale = 'en'
} = Astro.props;

// Auto-generate canonical from current URL if not provided
const canonicalURL = canonical || new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=20260804-2" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png?v=20260804-2" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png?v=20260804-2" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png?v=20260804-2" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon-180.png?v=20260804-2" />
    <link rel="canonical" href={canonicalURL} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
